# ===========================================================================
#  CampusPulse backend — copy this file to  backend/.env  and edit it.
# ===========================================================================

# --- PostgreSQL -------------------------------------------------------------
# Percent-encode special characters in the password:  #  becomes  %23
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuspulse_db

# --- sessions ---------------------------------------------------------------
# Any long random string. Change it before putting the site on the internet.
JWT_SECRET=dev-only-change-me-please-set-JWT_SECRET
JWT_EXPIRE_MINUTES=1440

# --- the university clock ---------------------------------------------------
# Room availability is calculated in THIS timezone, not the server's.
CAMPUS_TIMEZONE=Asia/Yangon
# The last minute of the teaching day (20:00), used for "available for …".
CAMPUS_DAY_END_MINUTE=1200

# --- server -----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- first-run seed ---------------------------------------------------------
# Creates the admin / driver / student logins and lays out the campus:
# SEED_BUILDINGS x SEED_FLOORS x SEED_ROOMS_PER_FLOOR rooms.
SEED_ON_START=true
SEED_PASSWORD=campus123
SEED_BUILDINGS=4
SEED_FLOORS=6
SEED_ROOMS_PER_FLOOR=6

# --- the C++ engine ---------------------------------------------------------
# Built with  bash cpp/build.sh  (or cpp\build.bat). Left unbuilt, the API
# uses the TypeScript twin of the same rules and says so on /health.

# --- login throttle ---------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
